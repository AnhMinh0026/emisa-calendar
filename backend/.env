# ==============================================================
# FILE MAU CAU HINH MOI TRUONG - emisa-calendar Backend
# --------------------------------------------------------------
# Sao chep file nay thanh .env va dien cac gia tri thuc te.
# TUYET DOI KHONG commit file .env vao Git (da co trong .gitignore).
# ==============================================================

# --- MongoDB Atlas ---
# Chuoi ket noi day du tu MongoDB Atlas > Connect > Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:admin@cluster0.tbvqv7l.mongodb.net/?appName=Cluster0
# --- Cau hinh Server ---
PORT=5000
NODE_ENV=development

# --- JWT / Auth (bo sung sau khi trien khai Auth module) ---
# JWT_SECRET=your_super_secret_jwt_key_here
# JWT_EXPIRES_IN=7d
